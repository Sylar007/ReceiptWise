<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceiptWise.App.ViewModels"
             x:Class="ReceiptWise.App.Views.InsightsPage"
             Title="{Binding Title}"
             x:DataType="vm:InsightsViewModel">

    <VerticalStackLayout 
        Padding="20" 
        Spacing="20"
        VerticalOptions="Center">

        <Label 
            Text="📊 Spending Insights"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label 
            Text="Charts and analytics coming in Milestone 7"
            FontSize="16"
            TextColor="Gray"
            HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>