                                        <Label Grid.Column="0" 
                                               Text="{Binding Category}" 
                                               FontSize="14" FontAttributes="Bold" 
                                               VerticalOptions="Center" />

                                        <ProgressBar Grid.Column="1" 
                                                     Progress="{Binding Percentage, Converter={StaticResource PercentageToProgressConverter}}"
                                                     ProgressColor="{StaticResource Primary}"
                                                     VerticalOptions="Center" />

                                        <Label Grid.Column="2" 
                                               Text="{Binding Percentage, StringFormat='{0:F1}%'}" 
                                               FontSize="12" TextColor="Gray" 
                                               VerticalOptions="Center" />

                                        <Label Grid.Column="3" 
                                               Text="{Binding TotalSpent, StringFormat='${0:F2}'}" 
                                               FontSize="14" FontAttributes="Bold" 
                                               TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>-->

            <!-- Top Merchants -->
            <!--<Frame Padding="15" CornerRadius="10" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Top Merchants" FontSize="18" FontAttributes="Bold" />

                    <CollectionView ItemsSource="{Binding TopMerchants}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Padding="12" Margin="0,3" CornerRadius="8" 
                                       BackgroundColor="{StaticResource Secondary}" HasShadow="False">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                                        <Label Grid.Column="0" 
                                               Text="{Binding ReceiptCount}" 
                                               FontSize="20" FontAttributes="Bold" 
                                               TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center" />

                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{Binding MerchantName}" 
