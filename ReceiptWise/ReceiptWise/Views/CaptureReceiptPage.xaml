<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceiptWise.App.ViewModels"
             x:Class="ReceiptWise.App.Views.CaptureReceiptPage"
             Title="{Binding Title}"
             x:DataType="vm:CaptureReceiptViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Status Message -->
            <Frame 
                Padding="15"
                CornerRadius="8"
                BackgroundColor="{StaticResource Secondary}">
                <HorizontalStackLayout Spacing="10">
                    <Label 
                        Text="ℹ️"
                        FontSize="20" />
                    <Label 
                        Text="{Binding StatusMessage}"
                        FontSize="14"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Frame>

            <!-- Error Message -->
            <Frame 
                IsVisible="{Binding HasError}"
                BackgroundColor="#FFEBEE"
                BorderColor="#F44336"
                Padding="10"
                CornerRadius="5">
                <Label 
                    Text="{Binding ErrorMessage}"
                    TextColor="#D32F2F" />
            </Frame>

            <!-- Loading Indicator -->
            <ActivityIndicator 
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource Primary}"
                HeightRequest="50" />

            <!-- Processing Progress -->
            <ProgressBar 
                Progress="{Binding ProcessingProgress}"
                IsVisible="{Binding IsProcessing}"
                ProgressColor="{StaticResource Primary}"
                HeightRequest="10" />

            <!-- Image Preview -->
            <Frame 
                IsVisible="{Binding HasImage}"
                Padding="0"
                CornerRadius="10"
                HasShadow="True"
                BorderColor="{StaticResource Primary}">
                <Image 
                    Source="{Binding CapturedImage}"
                    Aspect="AspectFit"
                    HeightRequest="300" />
            </Frame>

            <!-- Placeholder when no image -->
            <Frame 
                IsVisible="{Binding HasImage, Converter={StaticResource InvertedBoolConverter}}"
                Padding="40"
                CornerRadius="10"
                HasShadow="True"
                BackgroundColor="{StaticResource Gray100}">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <Label 
                        Text="📷"
                        FontSize="80"
                        HorizontalOptions="Center" />
                    <Label 
                        Text="No receipt captured yet"
                        FontSize="16"
                        TextColor="Gray"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Action Buttons -->
            <Grid 
                ColumnDefinitions="*,*"
                ColumnSpacing="15"
                RowDefinitions="Auto,Auto"
                RowSpacing="15">

                <Button 
                    Grid.Row="0" Grid.Column="0"
                    Text="📷 Camera"
                    Command="{Binding TakePhotoCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    HeightRequest="60"
                    FontSize="16" />

                <Button 
                    Grid.Row="0" Grid.Column="1"
                    Text="📁 Import"
                    Command="{Binding PickFileCommand}"
                    BackgroundColor="{StaticResource Secondary}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    HeightRequest="60"
                    FontSize="16" />

                <Button 
                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Text="🤖 Extract with AI"
                    Command="{Binding ProcessWithAICommand}"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    IsEnabled="{Binding HasImage}"
                    HeightRequest="60"
                    FontSize="18"
                    FontAttributes="Bold" />
            </Grid>

            <Button 
                Text="🗑️ Clear"
                Command="{Binding ClearCaptureCommand}"
                BackgroundColor="Gray"
                IsEnabled="{Binding HasImage}"
                HeightRequest="50" />

            <!-- Instructions -->
            <Frame 
                Padding="15"
                CornerRadius="8"
                BackgroundColor="#E3F2FD">
                <VerticalStackLayout Spacing="10">
                    <Label 
                        Text="📝 How to use:"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#1976D2" />
                    <Label 
                        Text="1. Capture or import a receipt image"
                        FontSize="14"
                        TextColor="#1976D2" />
                    <Label 
                        Text="2. Tap 'Extract with AI' button"
                        FontSize="14"
                        TextColor="#1976D2" />
                    <Label 
                        Text="3. AI will extract merchant, date, total, items"
                        FontSize="14"
                        TextColor="#1976D2" />
                    <Label 
                        Text="4. Receipt saved automatically"
                        FontSize="14"
                        TextColor="#1976D2" />
                    <BoxView 
                        HeightRequest="1"
                        Color="#1976D2"
                        Margin="0,5" />
                    <Label 
                        Text="⚡ Powered by Azure Document Intelligence"
                        FontSize="12"
                        FontAttributes="Italic"
                        TextColor="Gray"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>