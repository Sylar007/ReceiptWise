<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceiptWise.App.ViewModels"
             xmlns:models="clr-namespace:ReceiptWise.Core.Models.Domain;assembly=ReceiptWise.Core"
             x:Class="ReceiptWise.App.Views.ReceiptDetailPage"
             Title="{Binding Title}"
             x:DataType="vm:ReceiptDetailViewModel">

    <ContentPage.ToolbarItems>
        <ToolbarItem 
            Text="{Binding IsEditing, Converter={StaticResource EditModeTextConverter}}"
            IconImageSource="{Binding IsEditing, Converter={StaticResource EditModeIconConverter}}"
            Command="{Binding ToggleEditCommand}" />
        <ToolbarItem 
        Text="Export"
        IconImageSource="export.png"
        Command="{Binding ExportReceiptCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Loading Indicator -->
            <ActivityIndicator 
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource Primary}"
                HeightRequest="50" />

            <!-- Error Message -->
            <Frame 
                IsVisible="{Binding HasError}"
                BackgroundColor="#FFEBEE"
                BorderColor="#F44336"
                Padding="10"
                CornerRadius="5">
                <Label 
                    Text="{Binding ErrorMessage}"
                    TextColor="#D32F2F" />
            </Frame>

            <!-- Attachment Preview -->
            <Frame 
                IsVisible="{Binding HasAttachment}"
                Padding="0"
                CornerRadius="10"
                HasShadow="True"
                BorderColor="{StaticResource Primary}">
                <Grid>
                    <Image 
                        Source="{Binding AttachmentImage}"
                        Aspect="AspectFit"
                        HeightRequest="200" />

                    <Button 
                        Text="🔍 View Full Size"
                        Command="{Binding ViewAttachmentCommand}"
                        BackgroundColor="#80000000"
                        TextColor="White"
                        VerticalOptions="End"
                        Margin="10" />
                </Grid>
            </Frame>

            <!-- Receipt Details Card -->
            <Frame 
                IsVisible="{Binding Receipt, Converter={StaticResource IsNotNullConverter}}"
                Padding="20"
                CornerRadius="10"
                HasShadow="True">
                <VerticalStackLayout Spacing="15">

                    <!-- Merchant Name -->
                    <VerticalStackLayout Spacing="5">
                        <Label 
                            Text="Merchant"
                            FontSize="12"
                            TextColor="Gray" />
                        <Entry 
                            Text="{Binding MerchantName}"
                            FontSize="20"
                            FontAttributes="Bold"
                            IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="{Binding IsEditing, Converter={StaticResource EditingBackgroundConverter}}" />
                    </VerticalStackLayout>

                    <!-- Total Amount -->
                    <VerticalStackLayout Spacing="5">
                        <Label 
                            Text="Total"
                            FontSize="12"
                            TextColor="Gray" />
                        <Entry 
                            Text="{Binding Total, StringFormat='{0:F2}'}"
                            FontSize="28"
                            TextColor="{StaticResource Primary}"
                            Keyboard="Numeric"
                            IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="{Binding IsEditing, Converter={StaticResource EditingBackgroundConverter}}">
                            <Entry.Behaviors>
                                <toolkit:EventToCommandBehavior
                                    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                                    EventName="TextChanged"
                                    Command="{Binding CalculateSubtotalCommand}" />
                            </Entry.Behaviors>
                        </Entry>
                    </VerticalStackLayout>

                    <!-- Transaction Date -->
                    <VerticalStackLayout Spacing="5">
                        <Label 
                            Text="Transaction Date"
                            FontSize="12"
                            TextColor="Gray" />
                        <DatePicker 
                            Date="{Binding TransactionDate}"
                            FontSize="16"
                            IsEnabled="{Binding IsEditing}"
                            BackgroundColor="{Binding IsEditing, Converter={StaticResource EditingBackgroundConverter}}" />
                    </VerticalStackLayout>

                    <!-- Category -->
                    <VerticalStackLayout Spacing="5">
                        <Label 
                            Text="Category"
                            FontSize="12"
                            TextColor="Gray" />
                        <Frame 
                            Padding="12"
                            CornerRadius="8"
                            BackgroundColor="{StaticResource Secondary}"
                            HasShadow="False">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label 
                                    Grid.Column="0"
                                    Text="{Binding SelectedCategory}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Primary}"
                                    VerticalOptions="Center" />

                                <Button 
                                    Grid.Column="1"
                                    Text="Change"
                                    Command="{Binding ChangeCategoryCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    FontSize="12"
                                    Padding="10,5"
                                    CornerRadius="5" />
                            </Grid>
                        </Frame>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />

                    <!-- Tax -->
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="Tax:" FontSize="14" VerticalOptions="Center" />
                        <Entry 
                            Grid.Column="1"
                            Text="{Binding Tax, StringFormat='{0:F2}'}"
                            FontSize="14"
                            HorizontalTextAlignment="End"
                            Keyboard="Numeric"
                            IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="{Binding IsEditing, Converter={StaticResource EditingBackgroundConverter}}">
                            <Entry.Behaviors>
                                <toolkit:EventToCommandBehavior
                                    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                                    EventName="TextChanged"
                                    Command="{Binding CalculateSubtotalCommand}" />
                            </Entry.Behaviors>
                        </Entry>
                    </Grid>

                    <!-- Subtotal -->
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="Subtotal:" FontSize="14" VerticalOptions="Center" />
                        <Label 
                            Grid.Column="1"
                            Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                            FontSize="14"
                            HorizontalTextAlignment="End"
                            FontAttributes="Bold" />
                    </Grid>

                    <!-- Notes -->
                    <VerticalStackLayout Spacing="5">
                        <Label 
                            Text="Notes"
                            FontSize="12"
                            TextColor="Gray" />
                        <Editor 
                            Text="{Binding Notes}"
                            FontSize="14"
                            HeightRequest="80"
                            IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="{Binding IsEditing, Converter={StaticResource EditingBackgroundConverter}}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Line Items -->
            <Frame 
                IsVisible="{Binding Items.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                Padding="20"
                CornerRadius="10"
                HasShadow="True">
                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label 
                            Grid.Column="0"
                            Text="Items"
                            FontSize="18"
                            FontAttributes="Bold" />

                        <Button 
                            Grid.Column="1"
                            Text="+ Add"
                            Command="{Binding AddItemCommand}"
                            IsVisible="{Binding IsEditing}"
                            BackgroundColor="{StaticResource Primary}"
                            FontSize="12"
                            Padding="10,5"
                            CornerRadius="5" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Items}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ReceiptItem">
                                <Frame 
                                    Padding="12"
                                    Margin="0,3"
                                    CornerRadius="8"
                                    BackgroundColor="{StaticResource Gray100}"
                                    HasShadow="False">
                                    <Grid ColumnDefinitions="*,Auto,Auto">

                                        <VerticalStackLayout Grid.Column="0">
                                            <Label 
                                                Text="{Binding Description}"
                                                FontSize="14"
                                                FontAttributes="Bold" />
                                            <Label 
                                                Text="{Binding Quantity, StringFormat='Qty: {0}'}"
                                                FontSize="12"
                                                TextColor="Gray" />
                                        </VerticalStackLayout>

                                        <Label 
                                            Grid.Column="1"
                                            Text="{Binding TotalPrice, StringFormat='${0:F2}'}"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            VerticalOptions="Center"
                                            Margin="0,0,10,0" />

                                        <Button 
                                            Grid.Column="2"
                                            Text="✕"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReceiptDetailViewModel}}, Path=RemoveItemCommand}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ReceiptDetailViewModel}}, Path=IsEditing}"
                                            BackgroundColor="Red"
                                            TextColor="White"
                                            FontSize="12"
                                            WidthRequest="30"
                                            HeightRequest="30"
                                            Padding="0"
                                            CornerRadius="15" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Frame>

            <!-- Action Buttons -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEditing}">
                <Button 
                    Text="💾 Save Changes"
                    Command="{Binding SaveChangesCommand}"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="50" />

                <Button 
                    Text="Cancel"
                    Command="{Binding ToggleEditCommand}"
                    BackgroundColor="Gray"
                    TextColor="White"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="50" />
            </VerticalStackLayout>

            <Button 
                Text="🗑️ Delete Receipt"
                Command="{Binding DeleteReceiptCommand}"
                IsVisible="{Binding IsEditing, Converter={StaticResource InvertedBoolConverter}}"
                BackgroundColor="Red"
                TextColor="White"
                CornerRadius="10"
                Margin="0,20,0,0" />

            <!-- Add this button to ReceiptDetailPage.xaml -->
            <Button 
    Text="📅 Manage Warranty"
    Command="{Binding ManageWarrantyCommand}"
    BackgroundColor="#4CAF50"
    TextColor="White"
    CornerRadius="10"
    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>