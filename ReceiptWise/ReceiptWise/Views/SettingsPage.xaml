<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceiptWise.App.ViewModels"
             x:Class="ReceiptWise.App.Views.SettingsPage"
             Title="{Binding Title}"
             x:DataType="vm:SettingsViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- AI Settings -->
            <Frame Padding="15" CornerRadius="10" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label 
                        Text="AI Features"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label 
                            Grid.Column="0"
                            Text="Enable AI Extraction"
                            VerticalOptions="Center" />
                        <Switch 
                            Grid.Column="1"
                            IsToggled="{Binding AiEnabled}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Data Management -->
            <Frame Padding="15" CornerRadius="10" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label 
                        Text="Data Management"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Button 
                        Text="Export Data (CSV)"
                        Command="{Binding ExportDataCommand}"
                        BackgroundColor="{StaticResource Primary}" />

                    <Button 
                        Text="Clear Cache"
                        Command="{Binding ClearCacheCommand}"
                        BackgroundColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <!-- App Info -->
            <Frame Padding="15" CornerRadius="10" HasShadow="True">
                <VerticalStackLayout Spacing="5">
                    <Label 
                        Text="About"
                        FontSize="18"
                        FontAttributes="Bold" />
                    <Label 
                        Text="{Binding AppVersion, StringFormat='Version: {0}'}"
                        FontSize="14"
                        TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>