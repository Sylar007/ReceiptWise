<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceiptWise.App.ViewModels"
             x:Class="ReceiptWise.App.Views.SettingsPage"
             Title="{Binding Title}"
             x:DataType="vm:SettingsViewModel">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
            EventName="Appearing"
            Command="{Binding LoadDatabaseStatsCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Azure AI Configuration -->
            <Frame Padding="15" CornerRadius="10" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label 
                        Text="🤖 Azure AI Configuration"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Status:" VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1" 
                               Text="{Binding AzureConfigured, Converter={StaticResource BoolToStatusConverter}}"
                               TextColor="{Binding AzureConfigured, Converter={StaticResource BoolToColorConverter}}"
                               FontAttributes="Bold" />

                        <Label Grid.Row="1" Grid.Column="0" Text="AI Enabled:" VerticalOptions="Center" />
                        <Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding AiEnabled}" />
                    </Grid>

                    <Label Text="{Binding AzureEndpoint, StringFormat='Endpoint: {0}'}" 
                           FontSize="12" 
                           TextColor="Gray" 
                           LineBreakMode="TailTruncation" />

                    <Button 
                        Text="⚙️ Configure Azure Credentials"
                        Command="{Binding ConfigureAzureCommand}"
                        BackgroundColor="{StaticResource Primary}" />

                    <Label 
                        Text="⚠️ Required for AI extraction. Free tier available at portal.azure.com"
                        FontSize="11"
                        TextColor="Gray"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Frame>

            <!-- Database Stats -->
            <Frame Padding="15" CornerRadius="10" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label 
                        Text="📊 Database Statistics"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5">
                        <Label Grid.Row="0" Grid.Column="0" Text="Total Receipts:" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding ReceiptCount}" FontAttributes="Bold" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Database Size:" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding DatabaseSizeKB, StringFormat='{0} KB'}" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Developer Tools -->
            <Frame Padding="15" CornerRadius="10" HasShadow="True" BackgroundColor="#FFF3E0">
                <VerticalStackLayout Spacing="10">
                    <Label 
                        Text="🛠️ Developer Tools"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Button 
                        Text="Seed Sample Data (20 receipts)"
                        Command="{Binding SeedSampleDataCommand}"
                        BackgroundColor="#4CAF50" />

                    <Button 
                        Text="Clear All Data"
                        Command="{Binding ClearAllDataCommand}"
                        BackgroundColor="#F44336"
                        TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <!-- Data Management -->
            <Frame Padding="15" CornerRadius="10" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label 
                        Text="💾 Data Management"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Button 
                        Text="Export Data (CSV)"
                        Command="{Binding ExportDataCommand}"
                        BackgroundColor="{StaticResource Primary}" />

                    <Button 
                        Text="Clear Cache"
                        Command="{Binding ClearCacheCommand}"
                        BackgroundColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <!-- App Info -->
            <Frame Padding="15" CornerRadius="10" HasShadow="True">
                <VerticalStackLayout Spacing="5">
                    <Label 
                        Text="ℹ️ About"
                        FontSize="18"
                        FontAttributes="Bold" />
                    <Label 
                        Text="{Binding AppVersion, StringFormat='Version: {0}'}"
                        FontSize="14"
                        TextColor="Gray" />
                    <Label 
                        Text="Built with .NET MAUI 8"
                        FontSize="12"
                        TextColor="Gray" />
                    <Label 
                        Text="Powered by Azure AI"
                        FontSize="12"
                        TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <ActivityIndicator 
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>