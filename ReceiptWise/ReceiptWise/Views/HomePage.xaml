<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ReceiptWise.App.ViewModels"
             x:Class="ReceiptWise.App.Views.HomePage"
             Title="{Binding Title}"
             x:DataType="vm:HomeViewModel">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
            EventName="Appearing"
            Command="{Binding LoadDashboardCommand}" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label 
                Text="ReceiptWise"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- Error Message -->
            <Frame 
                IsVisible="{Binding HasError}"
                BackgroundColor="#FFEBEE"
                BorderColor="#F44336"
                Padding="10"
                CornerRadius="5">
                <Label 
                    Text="{Binding ErrorMessage}"
                    TextColor="#D32F2F" />
            </Frame>

            <!-- Loading Indicator -->
            <ActivityIndicator 
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource Primary}"
                HeightRequest="50" />

            <!-- This Month Card -->
            <Frame 
                Padding="20"
                CornerRadius="10"
                HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label 
                        Text="This Month"
                        FontSize="18"
                        FontAttributes="Bold" />
                    <Label 
                        Text="{Binding ThisMonthTotal, StringFormat='${0:F2}'}"
                        FontSize="36"
                        TextColor="{StaticResource Primary}" />
                    <Label 
                        Text="{Binding ReceiptCount, StringFormat='{0} receipts'}"
                        FontSize="14"
                        TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>

            <!-- Quick Actions -->
            <Label 
                Text="Quick Actions"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,20,0,10" />

            <Grid 
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="*,*"
                RowSpacing="15"
                ColumnSpacing="15">

                <Button 
                    Grid.Row="0" Grid.Column="0"
                    Text="📷 Capture"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToCaptureCommand}"
                    BackgroundColor="{StaticResource Primary}" />

                <Button 
                    Grid.Row="0" Grid.Column="1"
                    Text="📋 View All"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToReceiptsCommand}"
                    BackgroundColor="{StaticResource Secondary}" />

                <Button 
                    Grid.Row="1" Grid.Column="0"
                    Text="📊 Insights"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToInsightsCommand}"
                    BackgroundColor="{StaticResource Tertiary}" />

                <Button 
                    Grid.Row="1" Grid.Column="1"
                    Text="⚙️ Settings"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.NavigateToSettingsCommand}"
                    BackgroundColor="Gray" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>